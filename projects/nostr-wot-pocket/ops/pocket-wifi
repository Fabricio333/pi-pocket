#!/usr/bin/python3
"""Narrow root helper: NetworkManager only; credentials arrive on stdin."""
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import time

STATE = Path('/run/pocket-wifi')

def nm(*args, check=True):
    return subprocess.run(['nmcli', '--wait', '30', *args], capture_output=True,
                          text=True, check=check, timeout=40).stdout.strip()

def start():
    STATE.mkdir(mode=0o700, exist_ok=True)
    previous = nm('-g', 'GENERAL.CON-UUID', 'device', 'show', 'wlan0')
    if previous and previous != '--': (STATE/'previous').write_text(previous)
    password = secrets.token_hex(6)
    ssid = 'SatsBell-' + secrets.token_hex(2).upper()
    nm('connection', 'delete', 'SatsBell-Setup', check=False)
    nm('connection', 'add', 'type', 'wifi', 'ifname', 'wlan0', 'con-name', 'SatsBell-Setup', 'ssid', ssid)
    nm('connection', 'modify', 'SatsBell-Setup', '802-11-wireless.mode', 'ap',
       '802-11-wireless.band', 'bg', 'ipv4.method', 'shared', 'ipv4.addresses', '192.168.4.1/24',
       'ipv6.method', 'disabled', 'wifi-sec.key-mgmt', 'wpa-psk', 'wifi-sec.psk', password,
       'connection.autoconnect', 'no')
    # Start a detached supervisor before replacing Wi-Fi, so SSH loss is harmless.
    subprocess.run(['systemd-run', '--unit=pocket-wifi-session', '--collect',
                    '/usr/local/sbin/pocket-wifi', 'serve'], check=True, capture_output=True)
    print(json.dumps({'ssid': ssid, 'password': password, 'url': 'http://192.168.4.1:8788',
                      'token': password, 'expires': int(time.time())+600}), flush=True)

def restore():
    nm('connection', 'down', 'SatsBell-Setup', check=False)
    if (STATE/'previous').exists():
        nm('connection', 'up', 'uuid', (STATE/'previous').read_text(), check=False)

def connect():
    data = json.loads(sys.stdin.read(4096))
    ssid, password = data.get('ssid'), data.get('password', '')
    if not isinstance(ssid, str) or not 1 <= len(ssid.encode()) <= 32 or '\x00' in ssid:
        raise ValueError('Invalid Wi-Fi name')
    if not isinstance(password, str) or any(c in password for c in '\n\r\x00') or (password and not 8 <= len(password) <= 63):
        raise ValueError('Password must contain 8–63 characters')
    # A root-only transient password file keeps the Wi-Fi secret out of argv.
    name = 'Pocket-' + secrets.token_hex(4)
    nm('connection', 'add', 'type', 'wifi', 'ifname', 'wlan0', 'con-name', name, 'ssid', ssid)
    try:
        args = ['connection', 'modify', name, 'connection.autoconnect-priority', '20']
        if password: args += ['wifi-sec.key-mgmt', 'wpa-psk', 'wifi-sec.psk-flags', '2']
        nm(*args)
        secret = STATE/'password'
        secret.write_text('802-11-wireless-security.psk:'+password+'\n'); secret.chmod(0o600)
        try:
            args = ['connection', 'up', name]
            if password: args += ['passwd-file', str(secret)]
            nm(*args)
        finally: secret.unlink(missing_ok=True)
        if password:
            # Save the credential through libnm using stdin, without shell interpolation.
            import gi
            gi.require_version('NM', '1.0')
            from gi.repository import NM, GLib
            client = NM.Client.new(None)
            connection = next(c for c in client.get_connections() if c.get_id() == name)
            setting = connection.get_setting_wireless_security()
            setting.set_property('psk', password)
            setting.set_property('psk-flags', 0)
            loop = GLib.MainLoop(); result=[]
            def saved(obj, res, _):
                try: result.append(obj.commit_changes_finish(res))
                except Exception: result.append(False)
                loop.quit()
            connection.commit_changes_async(True, None, saved, None); loop.run()
            if result != [True]: raise RuntimeError('Could not save Wi-Fi credentials')
        (STATE/'connected').write_text(name)
    except Exception:
        nm('connection', 'delete', name, check=False)
        nm('connection', 'up', 'SatsBell-Setup', check=False)
        raise

def serve():
    time.sleep(8)  # Let the screen show credentials before disconnecting station Wi-Fi.
    (STATE/'connected').unlink(missing_ok=True)
    try:
        nm('connection', 'up', 'SatsBell-Setup')
        deadline=time.monotonic()+600
        while time.monotonic()<deadline and not (STATE/'connected').exists(): time.sleep(2)
    finally:
        if not (STATE/'connected').exists(): restore()

if __name__ == '__main__':
    try:
        if len(sys.argv) != 2: raise ValueError('One action required')
        {'start':start, 'connect':connect, 'restore':restore, 'serve':serve}[sys.argv[1]]()
    except Exception as exc:
        print(type(exc).__name__+': Wi-Fi operation failed', file=sys.stderr)
        sys.exit(1)
